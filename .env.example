# Server Configuration
PORT=5001
NODE_ENV=test

API_URL = https://web-test.kindercare.app/api/v1

# Socket.IO CORS — comma-separated list of allowed origins (no trailing slash)
CLIENT_URL=http://localhost:3000

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=kindercare_db
DB_PORT=3306

# DigitalOcean Spaces Config
DO_SPACE_ENDPOINT=https://sgp1.digitaloceanspaces.com
DO_SPACE_KEY=your_space_access_key
DO_SPACE_SECRET=your_space_secret_key
DO_SPACE_BUCKET=your_space_bucket_name

# (Optional) Custom CDN or Custom Domain URL
DO_SPACE_CDN_URL=your_space_cdn_url

# Firebase Admin SDK & Web Config
FIREBASE_KEY_PATH=./kindercare-adminsdk-test.json
FIREBASE_API_KEY=AIzaSyA1_TEST_MOCK_KEY_XYZ
FIREBASE_AUTH_DOMAIN=kindercare-test.firebaseapp.com
FIREBASE_PROJECT_ID=kindercare-test
FIREBASE_STORAGE_BUCKET=kindercare-test.appspot.com
FIREBASE_MESSAGING_SENDER_ID=1111111111
FIREBASE_APP_ID=1:1111111111:web:testabc123

# QR Code Verification Config
QR_TOKEN_SECRET=your_qr_token_secret_key_here_at_least_32_bytes
QR_TOKEN_TTL=60

# MoMo Payment Sandbox Config — test credentials công khai của MoMo
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=F8BBA842ECF85
MOMO_SECRET_KEY=K951B6PE1waDMi640xX08PD3vg6EkVlz
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
# Domain of the parent-facing frontend app, used to build MoMo's redirectUrl after payment
MOMO_REDIRECT_BASE_URL=https://parent.kindercare.app

# VNPay Payment Sandbox Config — VNPay KHÔNG có sandbox dùng chung công khai như MoMo,
# phải tự đăng ký tài khoản test tại https://sandbox.vnpayment.vn/devreg/ để lấy
# vnp_TmnCode + HashSecret riêng, không thể copy giá trị mẫu này chạy được.
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
# Trang FE mà VNPay redirect trình duyệt về sau khi thanh toán (không phải IPN — IPN URL
# phải cấu hình riêng trên merchant admin portal, trỏ tới {API_URL}/parent/invoices/vnpay-ipn)
VNPAY_RETURN_URL=https://parent.kindercare.app/billing/payment-result

